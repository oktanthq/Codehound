# GitHub App credentials. Never commit real values.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# Optional. Defaults to https://api.github.com
GITHUB_API_URL=

# Directory used for cloned worktrees during ingestion.
CODEHOUND_INGEST_ROOT=

# Webhook HTTP server. Defaults to 3000. PORT is accepted as a fallback.
CODEHOUND_PORT=3000

# Opt-in live GitHub suite (`npm run test:live`). Skipped when any of these are empty.
GITHUB_TEST_REPO=
GITHUB_TEST_INSTALLATION_ID=
GITHUB_TEST_PULL_NUMBER=
